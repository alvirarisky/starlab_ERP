# Custom build of frappe_docker's images/layered/Containerfile, adapted for
# this monorepo. The only real difference from upstream: erpnext/hrms still
# come from a real git URL (pinned tag, see docker/apps.json), but our own 4
# apps are copied in from the local build context (see the "starlab_apps"
# build context wired up in docker/start.sh) instead of being fetched from a
# git remote.
#
# Why this exists at all: `bench init --apps_path=apps.json` (used below)
# fetches every entry in apps.json via `bench get-app`, which needs each
# entry to be a git URL or a git-repo-root path -- and that path has to
# exist INSIDE this build step's filesystem, not on the host. Upstream
# frappe_docker assumes every app comes from a real git remote, which is
# fine for erpnext/hrms but not for apps that live as subfolders of THIS
# monorepo with no meaningful separate remote of their own. The previous
# approach to this same problem (docker/start.sh, before this file existed)
# force-pushed a `git subtree split` of each app subfolder to its own GitHub
# branch on every run just so `bench get-app <url>` had something to clone --
# this Containerfile removes the need for that entirely: the 4 app folders
# are COPYed in from the local build context, git-initialized as disposable
# repos right here (same trick this project's own CI already uses --
# .github/workflows/ci.yml, "Turn app subfolders into standalone git repos"),
# and apps.json (generated by start.sh, not the tracked docker/apps.json)
# points bench at those local paths instead of a remote.
ARG FRAPPE_BRANCH=v16.29.0
ARG FRAPPE_IMAGE_PREFIX=frappe

FROM ${FRAPPE_IMAGE_PREFIX}/build:${FRAPPE_BRANCH} AS builder

ARG FRAPPE_BRANCH=v16.29.0
ARG FRAPPE_PATH=https://github.com/frappe/frappe
ARG CACHE_BUST=""

USER frappe

# Local build context populated by docker/start.sh with the current content
# of starlab_customizations/starlab_integrations/starlab_lab_ops/starlab_quality
# (plain file copy, no .git) -- see the `--build-context starlab_apps=...`
# flag on the `docker build` invocation.
COPY --from=starlab_apps --chown=frappe:frappe . /opt/starlab_apps/

# Each app folder becomes its own disposable git repo so `bench get-app
# /opt/starlab_apps/<name>` (a local path) has something to clone from --
# bench get-app always does a real `git clone`, even for local paths, so the
# source needs a .git of its own. Nothing here is ever pushed anywhere; the
# whole builder stage (including these throwaway .git dirs) is discarded
# after this stage -- only the final `bench init` output is copied into the
# `backend` stage below.
RUN for app in starlab_customizations starlab_integrations starlab_lab_ops starlab_quality; do \
  cd "/opt/starlab_apps/$app" && \
  git init -q && \
  git add -A && \
  git -c user.email=build@localhost -c user.name=build commit -q -m "build snapshot"; \
  done

RUN --mount=type=secret,id=apps_json,target=/opt/frappe/apps.json,uid=1000,gid=1000 \
  : "${CACHE_BUST}" && \
  export APP_INSTALL_ARGS="" && \
  if [ -f /opt/frappe/apps.json ] && [ -s /opt/frappe/apps.json ]; then \
    export APP_INSTALL_ARGS="--apps_path=/opt/frappe/apps.json"; \
  fi && \
  bench init ${APP_INSTALL_ARGS}\
    --frappe-branch=${FRAPPE_BRANCH} \
    --frappe-path=${FRAPPE_PATH} \
    --no-procfile \
    --no-backups \
    --skip-redis-config-generation \
    --verbose \
    /home/frappe/frappe-bench && \
  cd /home/frappe/frappe-bench && \
  echo "{}" > sites/common_site_config.json && \
  find apps -mindepth 1 -path "*/.git" | xargs rm -fr

FROM ${FRAPPE_IMAGE_PREFIX}/base:${FRAPPE_BRANCH} AS backend

USER frappe

COPY --from=builder --chown=frappe:frappe /home/frappe/frappe-bench /home/frappe/frappe-bench

WORKDIR /home/frappe/frappe-bench

# Move assets to image-layer storage
RUN cp -r /home/frappe/frappe-bench/sites/assets /home/frappe/frappe-bench/assets && \
  rm -rf /home/frappe/frappe-bench/sites/assets

VOLUME [ \
  "/home/frappe/frappe-bench/sites", \
  "/home/frappe/frappe-bench/logs" \
]

USER root
# This entrypoint script link build assets of the image to the mounted sites volume at container initialization
COPY resources/core/main-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

COPY resources/core/start.sh /usr/local/bin/start.sh
RUN chmod 755 /usr/local/bin/start.sh

USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["start.sh"]
