# Copy this file to custom.env and adjust values as needed.
# custom.env itself is gitignored (kept local/per-machine).
# Reference: https://github.com/frappe/frappe_docker/blob/main/docs/02-setup/04-env-variables.md

# Unused fallback in this setup (CUSTOM_IMAGE/CUSTOM_TAG below always win --
# see compose.yaml's `${CUSTOM_IMAGE:-frappe/erpnext}:${CUSTOM_TAG:-$ERPNEXT_VERSION}`),
# kept in sync with docker/apps.json's erpnext pin anyway so it's correct if
# either of those is ever unset.
ERPNEXT_VERSION=v16.30.0

# Points compose at the image built locally with starlab_lab_ops baked in
CUSTOM_IMAGE=starlab-lab-ops
CUSTOM_TAG=latest
PULL_POLICY=never

DB_PASSWORD=admin123

# Force the frontend to always serve this site regardless of the Host header,
# so http://localhost:8080 works without editing the hosts file.
FRAPPE_SITE_NAME_HEADER=starlab.local

# Default value is `8080`.
HTTP_PUBLISH_PORT=
